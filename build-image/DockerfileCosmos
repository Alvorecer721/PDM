FROM nvcr.io/nvidia/pytorch:24.11-py3

# Set environment variables
ENV PYTHONUNBUFFERED=1

# Install APT packages
RUN DEBIAN_FRONTEND=noninteractive \
    apt-get update && \
    apt-get install -y --no-install-recommends \
    zsh \
    wget \
    git \
    git-lfs \
    sudo \
    bc \
    gdb \
    build-essential \
    tree \
    tmux \
    htop \
    python3-dev \
    python3-setuptools \
    make \
    cmake \
    yasm \
    pkg-config \
    libx264-dev \
    libx265-dev \
    libnuma-dev \
    libvpx-dev \
    libfdk-aac-dev \
    libmp3lame-dev \
    libopus-dev \
    libsdl2-dev \
    nvtop && \
    apt-get clean

# Build FFmpeg 4.4.4 from source
RUN cd /tmp && \
    wget -q https://ffmpeg.org/releases/ffmpeg-4.4.4.tar.bz2 && \
    tar -xf ffmpeg-4.4.4.tar.bz2 && \
    cd ffmpeg-4.4.4 && \
    ./configure \
    --prefix=/usr/local/ffmpeg4 \
    --enable-shared \
    --disable-static \
    --enable-gpl \
    --enable-version3 \
    --enable-nonfree \
    --enable-libx264 \
    --enable-libx265 && \
    make -j$(nproc) && \
    make install && \
    echo "/usr/local/ffmpeg4/lib" > /etc/ld.so.conf.d/ffmpeg4.conf && \
    ldconfig

# Set FFmpeg 4.x paths
ENV PATH="/usr/local/ffmpeg4/bin:${PATH}"
ENV LD_LIBRARY_PATH="/usr/local/ffmpeg4/lib:${LD_LIBRARY_PATH}"
ENV PKG_CONFIG_PATH="/usr/local/ffmpeg4/lib/pkgconfig:${PKG_CONFIG_PATH}"

# Clean up FFmpeg build files
RUN rm -rf /tmp/ffmpeg-4.4.4.tar.bz2 /tmp/ffmpeg-4.4.4

RUN rm /bin/sh && ln -s /bin/bash /bin/sh

WORKDIR /opt

COPY ./cosmos-predict1 /opt/cosmos-predict1

RUN cp /host/usr/lib64/libnvcuvid.so /usr/local/cuda/lib64 && \
    cp /host/usr/lib64/libnvcuvid.so.1 /usr/local/cuda/lib64

# Clone and build Decord with CUDA support first (before conda setup)
RUN cd /opt && \
    git clone --recursive https://github.com/dmlc/decord && \
    cd decord && \
    mkdir build && cd build && \
    PKG_CONFIG_PATH=/usr/local/ffmpeg4/lib/pkgconfig \
    cmake .. -DUSE_CUDA=ON \
             -DCMAKE_BUILD_TYPE=Release \
             -DFFMPEG_DIR=/usr/local/ffmpeg4

RUN cd /opt/decord/build && \
    make -j$(nproc) && \
    cd ../python && \
    pip install -e .
    
# First RUN command - Install Miniconda and set up the environment
RUN echo "Installing dependencies. This will take a while..." && \
    mkdir -p ~/miniconda3 && \
    wget https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-aarch64.sh -O ~/miniconda3/miniconda.sh && \
    bash ~/miniconda3/miniconda.sh -b -u -p ~/miniconda3 && \
    rm ~/miniconda3/miniconda.sh && \
    source ~/miniconda3/bin/activate && \
    cd cosmos-predict1 && \
    conda env create --file cosmos-predict1.yaml && \
    conda activate cosmos-predict1 && \
    echo "Environment setup complete"

    
# Set permissions
RUN chmod 777 -R /workspace
RUN chmod 777 -R /opt

# Add Cosmos-Tokenizer and Decord to Python path
ENV PYTHONPATH="${PYTHONPATH}:/opt/cosmos-predict1:/opt/decord"

WORKDIR /workspace

