FROM nvcr.io/nvidia/pytorch:24.10-py3

# Set environment variables
ENV PYTHONUNBUFFERED=1

# Install APT packages
RUN DEBIAN_FRONTEND=noninteractive \
    apt-get update && \
    apt-get install -y --no-install-recommends \
    zsh \
    wget \
    git \
    git-lfs \
    sudo \
    bc \
    gdb \
    build-essential \
    tree \
    ffmpeg \
    libsox-fmt-all \
    tmux \
    htop \
    python3-dev \
    python3-setuptools \
    make \
    cmake \
    libavcodec-dev \
    libavfilter-dev \
    libavformat-dev \
    libavutil-dev \
    nvtop && \
    apt-get clean

RUN rm /bin/sh && ln -s /bin/bash /bin/sh

WORKDIR /opt

COPY ./cosmos-predict1 /opt/cosmos-predict1
COPY ./PDM/build-image/transformer_engine-1.12.0+7a7225c-cp310-cp310-linux_aarch64.whl /opt

RUN mkdir -p /usr/local/nvidia/lib64 && \
    cp /host/usr/lib64/libdcgm* /usr/local/nvidia/lib64 && \
    cp /host/usr/lib64/libnvcuvid.so /usr/local/cuda/lib64 && \
    cp /host/usr/lib64/libnvcuvid.so.1 /usr/local/cuda/lib64 && \
    export LD_LIBRARY_PATH="${LD_LIBRARY_PATH}:/usr/local/nvidia/lib64"

# Clone and build Decord with CUDA support first (before conda setup)
RUN cd /opt && \
    git clone --recursive https://github.com/dmlc/decord && \
    cd decord && \
    mkdir build && cd build && \
    cmake .. -DUSE_CUDA=ON -DCMAKE_BUILD_TYPE=Release && \
    make -j$(nproc) && \
    cd ../python && \
    pip install -e .
    
# First RUN command - Install Miniconda and set up the environment
RUN echo "Installing dependencies. This will take a while..." && \
    mkdir -p ~/miniconda3 && \
    wget https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-aarch64.sh -O ~/miniconda3/miniconda.sh && \
    bash ~/miniconda3/miniconda.sh -b -u -p ~/miniconda3 && \
    rm ~/miniconda3/miniconda.sh && \
    source ~/miniconda3/bin/activate && \
    cd cosmos-predict1 && \
    conda env create --file cosmos-predict1.yaml && \
    conda activate cosmos-predict1 && \
    # Create bazel configuration to limit parallelism
    mkdir -p ~/.bazelrc && \
    echo "build --jobs=50" > ~/.bazelrc && \
    # Install the requirements
    pip install --no-cache-dir -r requirements.txt && \
    # Try to install tensorstore with specific options to limit parallel jobs
    BAZEL_OPTS="--jobs=50" pip install tensorstore || \
    # If that fails, try pre-compiled version
    pip install --no-build-isolation tensorstore && \
    # Link required include files
    ln -sf $CONDA_PREFIX/lib/python3.10/site-packages/nvidia/*/include/* $CONDA_PREFIX/include/ && \
    ln -sf $CONDA_PREFIX/lib/python3.10/site-packages/nvidia/*/include/* $CONDA_PREFIX/include/python3.10 && \
    ln -sf $CONDA_PREFIX/lib/python3.10/site-packages/triton/backends/nvidia/include/* $CONDA_PREFIX/include/


# Second RUN command - Install TransformerEngine and Apex
RUN source ~/miniconda3/bin/activate && \
    conda activate cosmos-predict1 && \
    pip3 install transformer_engine-1.12.0+7a7225c-cp310-cp310-linux_aarch64.whl && \
    git clone https://github.com/NVIDIA/apex && cd apex && \
    CUDA_HOME=$CONDA_PREFIX pip install -v --no-cache-dir --no-build-isolation --config-settings "--build-option=--cpp_ext" --config-settings "--build-option=--cuda_ext" . && \
    echo "Environment setup complete"

    
# Set permissions
RUN chmod 777 -R /workspace
RUN chmod 777 -R /opt

# Add Cosmos-Tokenizer and Decord to Python path
ENV PYTHONPATH="${PYTHONPATH}:/opt/cosmos-predict1:/opt/decord"

WORKDIR /workspace

